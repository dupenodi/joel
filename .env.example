HYDRA_HTTP=http://hydradb:8443
HYDRA_BOLT=neo4j://hydradb:7687
HYDRA_TOKEN=local-development-token-32-bytes
# Root graph namespace and base Bolt database. These must match HydraDB's own
# GRAPH_NAMESPACE and GRAPH_DATABASE. Each workspace gets its own scope
# *underneath* these — joel derives it, so don't set a per-workspace value here.
HYDRA_NAMESPACE=default
HYDRA_DATABASE=default
HYDRA_CELL=cell-0
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_DISTILL=anthropic/claude-sonnet-4.5
LLM_MODEL_EXTRACT=anthropic/claude-sonnet-4.5
LLM_MODEL_ANSWER=anthropic/claude-sonnet-4.5
LLM_MODEL_RESOLVE=anthropic/claude-haiku-4.5
LLM_MODEL_RERANK=anthropic/claude-haiku-4.5
COMPOSIO_API_KEY=

# joel install
JOEL_DATA=./data
# Fernet key for connector credential blobs (generate once, keep secret)
JOEL_SECRET=
# Public URL of the web app (invite links, MCP OAuth issuer, CORS). Must be
# the origin in the browser, including port (this machine's joel web is often
# :3001 when :3000 is already taken).
JOEL_WEB_ORIGIN=http://localhost:3000
# Website research (onboarding About seed). Set to 0 for air-gapped installs.
# JOEL_ALLOW_WEB_FETCH=0
# Set to 1 when serving over HTTPS so the session cookie gets Secure
JOEL_HTTPS=0
# cloud | selfhost. Usually inferred from JOEL_WEB_ORIGIN (meetjoel.xyz → cloud).
# JOEL_DEPLOYMENT=selfhost

# Hosted Slack app (Add to Slack). Leave blank when self-hosting — Settings
# has you create an app from the repo manifest instead.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
